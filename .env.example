# Contact form delivery
#
# The site does not send email itself. The /api/contact route validates the
# submission and forwards it as JSON to whatever endpoint you configure here.
# Until CONTACT_WEBHOOK_URL is set, the form responds with an honest
# "not configured" message and shows the phone number and email address, so the
# page never claims a message was sent when it was not.

# Required for the form to deliver. Any HTTPS endpoint that accepts a JSON POST.
# Examples: a Zapier/Make webhook, a Cloudflare Worker, an n8n or Make route.
CONTACT_WEBHOOK_URL=

# Optional. If your endpoint expects a bearer token, put it here.
CONTACT_WEBHOOK_TOKEN=